# =============================================
# NLSP School Website — Environment Variables
# =============================================
# Aage jab bhi koi naya key do, usi key ko
# yahan bhi add karo is format mein:
# KEY_NAME=
# =============================================

# Resend API Key — Admission form emails ke liye
RESEND_API_KEY=re_your_resend_api_key_here

# Groq API Key — school chatbot ke liye
GROQ_API_KEY=gsk_your_groq_api_key_here

# Session Secret — Login sessions ke liye
SESSION_SECRET=
